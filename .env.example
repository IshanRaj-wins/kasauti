# Copy to .env.local and fill in. Never commit it.
# NAME=value   # what it's for, where to get it

# Step grading + fallback transcription. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A free-tier, image-capable model. Confirm the current name in AI Studio (see docs/API-NOTES.md).
GEMINI_MODEL=gemini-3.5-flash-lite

# Spoken-code check (ElevenLabs Scribe, free plan). Optional: without it, Gemini transcribes.
ELEVENLABS_API_KEY=

# Signs the 90-second challenge tokens. `npm run gen-key` prints one.
CHALLENGE_SECRET=
# ES256 private JWK (one line of JSON) that signs skill passes. `npm run gen-key` prints one.
ISSUER_PRIVATE_JWK=

# Public origin used as the pass issuer and inside QR links, e.g. https://kasauti.vercel.app
PUBLIC_BASE_URL=http://localhost:3000
